/* labelwerk – modelled on RawBlock: black/white, strong borders, square.
   Replaceable: load another .qss file or none at all (system look). */

* {
    font-family: "Work Sans", "Inter", "DejaVu Sans", sans-serif;
    font-size: 14px;
    color: #000000;
}
QMainWindow, QWidget { background: #FFFFFF; }

QToolBar {
    background: #FFFFFF;
    border: none;
    border-bottom: 3px solid #000000;
    padding: 6px;
    spacing: 6px;
}
/* Qt subtracts the 3 px bottom border from the bottom padding – compensate so top = bottom */
QToolBar QToolButton { margin-bottom: 3px; }
QToolBar QToolButton {
    background: #FFFFFF;
    border: 3px solid #000000;
    border-radius: 0;
    padding: 6px 14px;
    font-weight: 700;
    letter-spacing: 2px;
}
QToolBar QToolButton:hover, QToolBar QToolButton:checked {
    background: #000000;
    color: #FFFFFF;
}
/* Edit bar: smaller buttons, separator as a black line */
QToolBar#editBar { padding: 4px 6px; }
QToolBar#editBar QToolButton { padding: 3px 10px; letter-spacing: 1px; }
QToolBar#editBar::separator { background: #000000; width: 3px; margin: 2px 8px 5px 8px; }
QToolBar QToolButton#print { background: #000000; color: #FFFFFF; }
/* Overflow of the tab buttons: narrow button "»" (Qt gives it a small fixed width) */
QToolBar QToolButton#qt_toolbar_ext_button { border: none; padding: 0; margin: 0; letter-spacing: 0; }
QToolBar QToolButton#qt_toolbar_ext_button[active="true"] { background: #000000; color: #FFFFFF; }
QToolBar QToolButton#print:hover { background: #FFFFFF; color: #000000; }
QToolBar QToolButton:disabled, QToolBar QToolButton#print:disabled {
    background: #F0F0F0;
    color: #999999;
    border-color: #CCCCCC;
}

#panelScroll { border: none; border-right: 3px solid #000000; }
QLabel#panelTitle { font-size: 22px; font-weight: 900; padding: 4px 0 8px 0; }
QLabel[role="section"] { font-weight: 900; letter-spacing: 1px; padding-top: 10px; }
QLabel#fixedSize { font-family: "Space Mono", "DejaVu Sans Mono", monospace; }

QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #F0F0F0;
    border: 3px solid #000000;
    border-radius: 0;
    padding: 6px 8px;
    font-family: "Space Mono", "DejaVu Sans Mono", monospace;
}
QPlainTextEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover { background: #E8E8E8; }
QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-width: 5px; }
/* Number fields: own up/down buttons – with a custom border Qt draws no arrows otherwise */
QSpinBox, QDoubleSpinBox { padding: 4px 32px 4px 8px; min-height: 26px; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    width: 26px;
    background: #FFFFFF;
    border-left: 3px solid #000000;
}
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-position: top right; border-bottom: 1px solid #000000; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-position: bottom right; }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background: #000000; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(@THEME@/arrow-up-black.svg); width: 10px; height: 7px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(@THEME@/arrow-down-black.svg); width: 10px; height: 7px; }
QSpinBox::up-arrow:hover, QDoubleSpinBox::up-arrow:hover { image: url(@THEME@/arrow-up-white.svg); }
QSpinBox::down-arrow:hover, QDoubleSpinBox::down-arrow:hover { image: url(@THEME@/arrow-down-white.svg); }
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled { image: url(@THEME@/arrow-up-gray.svg); }
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled { image: url(@THEME@/arrow-down-gray.svg); }
QSpinBox::up-button:disabled, QDoubleSpinBox::up-button:disabled,
QSpinBox::down-button:disabled, QDoubleSpinBox::down-button:disabled { border-left-color: #CCCCCC; background: #F5F5F5; }
QComboBox { padding: 4px 32px 4px 8px; min-height: 26px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 26px; border-left: 3px solid #000000; background: #FFFFFF; }
QComboBox::drop-down:hover { background: #000000; }
QComboBox::down-arrow { image: url(@THEME@/arrow-down-black.svg); width: 10px; height: 7px; }
QComboBox::down-arrow:hover { image: url(@THEME@/arrow-down-white.svg); }
/* display only (e.g. frame size without a fixed frame size): white, arrows grey */
QDoubleSpinBox[readOnly="true"] { background: #FFFFFF; }
QDoubleSpinBox[readOnly="true"]::up-arrow { image: url(@THEME@/arrow-up-gray.svg); }
QDoubleSpinBox[readOnly="true"]::down-arrow { image: url(@THEME@/arrow-down-gray.svg); }
QDoubleSpinBox[readOnly="true"]::up-button:hover, QDoubleSpinBox[readOnly="true"]::down-button:hover { background: #FFFFFF; }
QLabel#hint { border: 3px dashed #000000; padding: 8px; font-weight: 700; }
QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled { border-color: #CCCCCC; background: #F5F5F5; color: #999999; }
QComboBox::drop-down:disabled { border-left-color: #CCCCCC; background: #F5F5F5; }
QComboBox::down-arrow:disabled { image: url(@THEME@/arrow-down-gray.svg); }
QComboBox QAbstractItemView { border: 3px solid #000000; selection-background-color: #000000; selection-color: #FFFFFF; }

QCheckBox::indicator { width: 16px; height: 16px; border: 3px solid #000000; background: #FFFFFF; }
QCheckBox::indicator:checked { background: #000000; }
QCheckBox:disabled, QRadioButton:disabled, QLabel:disabled { color: #999999; }
QCheckBox::indicator:disabled { border-color: #CCCCCC; background: #F5F5F5; }
/* disabled but checked (e.g. FILE/PAPER under "Tabs in the toolbar"): visibly filled */
QCheckBox::indicator:checked:disabled { border-color: #999999; background: #999999; }
/* Slider (threshold): black line, square handle */
QSlider::groove:horizontal { height: 3px; background: #000000; }
QSlider::handle:horizontal { width: 12px; margin: -9px 0; background: #000000; border: none; }
QSlider::handle:horizontal:hover { background: #FFFFFF; border: 3px solid #000000; width: 6px; }
QSlider::groove:horizontal:disabled, QSlider::handle:horizontal:disabled { background: #CCCCCC; }

QLabel#error { color: #FF0000; border: 3px solid #FF0000; padding: 6px; }
QLabel#mediaStatus { padding: 0 10px; border-left: 2px solid #000000; font-weight: 700; }
QLabel#mediaStatus[state="ok"] { color: #008000; border-color: #008000; }
QLabel#mediaStatus[state="warn"] { color: #CC7A00; border-color: #FFA500; }
QLabel#mediaStatus[state="error"] { color: #FF0000; border-color: #FF0000; }
QPushButton { background: #FFFFFF; border: 3px solid #000000; border-radius: 0; padding: 6px 10px; font-weight: 700; letter-spacing: 1px; }
QPushButton:hover { background: #000000; color: #FFFFFF; }
QPushButton:disabled { border-color: #CCCCCC; color: #999999; background: #F0F0F0; }
QPushButton#formatButton { padding: 4px 8px; min-width: 22px; }
QPushButton#formatButton:checked { background: #000000; color: #FFFFFF; }
QPushButton#formatButton[style="italic"] { font-style: italic; }
QPushButton#formatButton[style="underline"] { text-decoration: underline; }
QTextEdit { background: #F0F0F0; border: 3px solid #000000; border-radius: 0; padding: 6px; }
QTextEdit:focus { border-width: 5px; }
QTextEdit:disabled { border-color: #CCCCCC; background: #F5F5F5; }
FontCombo { min-width: 0; }
/* LAYOUT tab: icon buttons; black on hover, the icon then turns white */
QToolButton#layoutButton { background: #FFFFFF; border: 3px solid #000000; border-radius: 0; padding: 6px; }
QToolButton#layoutButton:hover { background: #000000; }
QToolButton#layoutButton:disabled { background: #F0F0F0; border-color: #CCCCCC; }

/* Settings: tabs and shortcut table */
QTabWidget::pane { border: 3px solid #000000; top: -3px; }
QTabBar::tab {
    background: #FFFFFF;
    border: 3px solid #000000;
    padding: 6px 14px;
    margin-right: -3px;
    font-weight: 700;
    letter-spacing: 1px;
}
QTabBar::tab:selected { background: #000000; color: #FFFFFF; }
QTabBar::tab:hover:!selected { background: #E8E8E8; }
QTableWidget {
    border: 3px solid #000000;
    gridline-color: #CCCCCC;
    selection-background-color: #000000;
    selection-color: #FFFFFF;
}
QHeaderView::section {
    background: #000000;
    color: #FFFFFF;
    border: none;
    border-right: 1px solid #FFFFFF;
    padding: 4px 8px;
    font-weight: 700;
    letter-spacing: 1px;
}
QPushButton#tableButton { border-width: 2px; padding: 1px 8px; margin: 1px 2px; letter-spacing: 0; }
QKeySequenceEdit QLineEdit {
    background: #F0F0F0;
    border: 3px solid #000000;
    border-radius: 0;
    padding: 0 4px;
    font-family: "Space Mono", "DejaVu Sans Mono", monospace;
}

QStatusBar { border-top: 3px solid #000000; }
QStatusBar QLabel[state="ok"] { color: #008000; font-weight: 700; }
QStatusBar QLabel[state="error"] { color: #FF0000; font-weight: 700; }
QStatusBar QLabel[state="warn"] { color: #CC7A00; font-weight: 700; }
QStatusBar QToolButton { border: 2px solid #000000; padding: 0 8px; font-weight: 700; }
QStatusBar QToolButton:hover { background: #000000; color: #FFFFFF; }

QGraphicsView { border: none; }
QToolTip { background: #000000; color: #FFFFFF; border: none; padding: 8px 12px; font-family: "Space Mono", "DejaVu Sans Mono", monospace; }

/* "Insert symbol" window: search, groups, grid */
QLineEdit#symbolSearch { background: #F0F0F0; border: 3px solid #000000; border-radius: 0; padding: 4px 6px; }
QLineEdit#symbolSearch:focus { border-width: 5px; }
QListWidget#symbolGroups, QListView#symbolGrid {
    border: 3px solid #000000;
    selection-background-color: #000000;
    selection-color: #FFFFFF;
}
QListWidget#symbolGroups::item { padding: 4px 6px; }
QListWidget#symbolGroups::item:selected, QListView#symbolGrid::item:selected { background: #000000; color: #FFFFFF; }
